diff --git a/tests/preview_projection_tests.cpp b/tests/preview_projection_tests.cpp
new file mode 100644
index 0000000..7c8ddd3
--- /dev/null
+++ b/tests/preview_projection_tests.cpp
@@ -0,0 +1,60 @@
+#include "preview_projection.h"
+#include <iostream>
+#include <stdexcept>
+#include <string>
+#include <limits>
+
+void Check(bool yes,const char* what) { if(!yes) throw std::runtime_error(what); }
+bool Near(float a,float b) { return std::abs(a-b)<2e-6f; }
+float PixelX(float ray,const XrFovf& fov) {
+    const float l=std::tan(fov.angleLeft),r=std::tan(fov.angleRight);
+    return (ray-l)/(r-l);
+}
+int main(int argc,char** argv) try {
+    Check(argc==2,"test case required");const std::string test=argv[1];
+    constexpr float rad=.01745329252f;
+    const XrFovf optics[2]={{-54*rad,40*rad,43.98f*rad,-54.27f*rad},
+                           {-40*rad,54*rad,43.98f*rad,-54.27f*rad}};
+    const XrFovf submitted={-.94719f,.94719f,.94719f,-.94719f};
+    const XrRect2Di full={{0,0},{2560,2560}};
+    const XrPosef pose={{0,0,0,1},{0,1.7f,0}};
+    preview::ProjectionViews views;
+    if(test=="asymmetric") {
+        for(unsigned eye=0;eye<2;++eye) Check(views.Set(eye,pose,submitted,full,full),"valid projection rejected");
+        for(float angle:{-30*rad,0.0f,20*rad,30*rad}) {
+            const float ray=std::tan(angle);
+            const auto left=views.Resolve(0,pose,optics[0]),right=views.Resolve(1,pose,optics[1]);
+            Check(Near(PixelX(ray,left.fov),PixelX(ray,right.fov)),"HUD eyes differ over symmetric world images");
+            Check(Near(PixelX(ray,left.fov),PixelX(ray,submitted)),"overlay does not match submitted image projection");
+            Check(std::abs(PixelX(ray,optics[0])-PixelX(ray,optics[1]))>.24f,"fixture misses original preview mismatch");
+        }
+    } else if(test=="pose") {
+        auto rendered=pose;rendered.position.x=4;rendered.orientation={0,std::sin(.3f),0,std::cos(.3f)};
+        Check(views.Set(0,rendered,submitted,full,full),"submitted pose rejected");
+        const auto view=views.Resolve(0,pose,optics[0]);
+        Check(Near(view.pose.position.x,4) && Near(view.pose.orientation.y,std::sin(.3f)),"latest tracking replaced image camera");
+    } else if(test=="frame_reset") {
+        views.Set(0,pose,submitted,full,full);views.Reset();
+        Check(Near(views.Resolve(0,pose,optics[0]).fov.angleRight,optics[0].angleRight),"quad-only frame reused old gameplay camera");
+        views.Set(0,pose,submitted,full,full);
+        Check(Near(views.Resolve(1,pose,optics[1]).fov.angleLeft,optics[1].angleLeft),"missing eye reused another camera");
+    } else if(test=="crop") {
+        const XrRect2Di content={{256,512},{2048,1024}};
+        Check(views.Set(0,pose,submitted,content,full),"full-texture crop rejected");
+        const auto view=views.Resolve(0,pose,optics[0]);
+        for(float ray:{-.5f,0.0f,.5f}) {
+            const float expected=(256+PixelX(ray,submitted)*2048)/2560;
+            Check(Near(PixelX(ray,view.fov),expected),"Full Render image rect ignored");
+        }
+        const float centreY=std::tan(view.fov.angleUp)/(std::tan(view.fov.angleUp)-std::tan(view.fov.angleDown));
+        Check(Near(centreY,.4f),"vertical crop mismatch");
+    } else if(test=="invalid") {
+        views.Set(0,pose,submitted,full,full);
+        auto invalid=pose;invalid.orientation.w=std::numeric_limits<float>::quiet_NaN();
+        Check(!views.Set(0,invalid,submitted,full,full),"NaN camera accepted");
+        Check(Near(views.Resolve(0,pose,optics[0]).fov.angleLeft,optics[0].angleLeft),"failed replacement retained stale camera");
+        Check(!views.Set(0,pose,submitted,{{0,0},{0,2560}},full),"zero image extent accepted");
+        Check(!views.Set(2,pose,submitted,full,full),"invalid eye accepted");
+    } else throw std::runtime_error("unknown case");
+    std::cout<<test<<" passed\n";return 0;
+} catch(const std::exception& e) { std::cerr<<e.what()<<"\n";return 1; }
