+#pragma once
+#include <openxr/openxr.h>
+#include <array>
+#include <cmath>
+
+namespace preview {
+struct View {
+    XrPosef pose{};
+    XrFovf fov{};
+};
+
+// The mirror blits submitted projection images without optical reprojection.
+// Its overlays must therefore use those images' cameras, not xrLocateViews'
+// potentially different headset frusta and a newer tracking pose.
+class ProjectionViews {
+    std::array<View,2> views{};
+    std::array<bool,2> valid{};
+public:
+    void Reset() { valid.fill(false); }
+    bool Set(unsigned eye, const XrPosef& worldPose, const XrFovf& fov,
+             const XrRect2Di& submitted, const XrRect2Di& displayed) {
+        if(eye>=views.size()) return false;
+        valid[eye]=false;
+        const float angles[]={fov.angleLeft,fov.angleRight,fov.angleUp,fov.angleDown};
+        for(float a:angles) if(!std::isfinite(a) || std::abs(a)>=1.5707963f) return false;
+        const auto& q=worldPose.orientation;const auto& p=worldPose.position;
+        const float norm=q.x*q.x+q.y*q.y+q.z*q.z+q.w*q.w;
+        if(!std::isfinite(norm) || norm<.5f || norm>1.5f ||
+           !std::isfinite(p.x) || !std::isfinite(p.y) || !std::isfinite(p.z) ||
+           submitted.extent.width<=0 || submitted.extent.height<=0 ||
+           displayed.extent.width<=0 || displayed.extent.height<=0) return false;
+        const float l=std::tan(fov.angleLeft),r=std::tan(fov.angleRight);
+        const float u=std::tan(fov.angleUp),d=std::tan(fov.angleDown);
+        if(r-l<1e-6f || u-d<1e-6f) return false;
+        const float x=(float(displayed.offset.x)-float(submitted.offset.x))/float(submitted.extent.width);
+        const float y=(float(displayed.offset.y)-float(submitted.offset.y))/float(submitted.extent.height);
+        const float w=float(displayed.extent.width)/float(submitted.extent.width);
+        const float h=float(displayed.extent.height)/float(submitted.extent.height);
+        View view{worldPose, {std::atan(l+x*(r-l)),std::atan(l+(x+w)*(r-l)),
+                             std::atan(u-y*(u-d)),std::atan(u-(y+h)*(u-d))}};
+        const float inv=1/std::sqrt(norm);
+        view.pose.orientation={q.x*inv,q.y*inv,q.z*inv,q.w*inv};
+        views[eye]=view;valid[eye]=true;return true;
+    }
+    View Resolve(unsigned eye,const XrPosef& fallbackPose,const XrFovf& fallbackFov) const {
+        if(eye<views.size() && valid[eye]) return views[eye];
+        return {fallbackPose,fallbackFov};
+    }
+};
+}
